#!/bin/bash
#
# @TITLE@ -- MiSTer Scripts-menu entry: loads the @CORENAME@ core and starts the
# game. GENERATED by mister-platform render from mister-port.toml.
#
# With Scripts -> @NAME@_CoresMenu turned on (MiSTer.ini [@CORENAME@]
# main=/media/fat/linux/MiSTer_hybrid), loading the core also starts the game and
# this entry only loads the core. Otherwise this entry starts
# games/@NAME@/launch.sh itself once the core is up.

GAMEDIR=@GAMEDIR@
HANDLER="$GAMEDIR/launch.sh"
HOOK=/media/fat/linux/MiSTer_hybrid
INI=/media/fat/MiSTer.ini
RBF_GLOB="/media/fat/_Other/@NAME@_*.rbf"
CORENAME="@CORENAME@"
LOGDIR=@LOGDIR@
CORE_WAIT_S=30

mkdir -p "$LOGDIR"
echo "@TITLE@: loading core and starting the engine..."
echo "log: $LOGDIR/launch.log"
exec >> "$LOGDIR/launch.log" 2>&1
echo "=== $(date) Scripts entry (pid $$)"

die() { echo "launcher: $*"; exit 1; }

[ -f "$HANDLER" ] || die "handler not found: $HANDLER"
@REQUIRED_FILES@
# update_all and zip extraction don't preserve the execute bit.
chmod +x "$HANDLER" "$HOOK" "$GAMEDIR/@PROCESS@" 2>/dev/null
@SCRIPTS_EXTRA@
main_on() { [ -x "$HOOK" ] && [ -f "/media/fat/linux/hybrid.d/$CORENAME.conf" ] && grep -q "^main=$HOOK" "$INI" 2>/dev/null; }
# shellcheck disable=SC2009  # busybox pgrep -f is not guaranteed on MiSTer
launcher_running() { ps -o args | grep -q '[@NAME_FIRST@]@NAME_REST@/launch.sh'; }

# --- core ------------------------------------------------------------------------
if [ "$(cat /tmp/CORENAME 2>/dev/null)" != "$CORENAME" ]; then
	# shellcheck disable=SC2012,SC2086  # the glob must expand; newest first
	RBF="$(ls -t $RBF_GLOB 2>/dev/null | head -1)"
	[ -n "$RBF" ] || die "no RBF matching $RBF_GLOB"
	[ -p /dev/MiSTer_cmd ] || die "/dev/MiSTer_cmd missing -- is MiSTer running?"
	echo "launcher: load_core $RBF"
	echo "load_core $RBF" > /dev/MiSTer_cmd
	if main_on; then
		echo "launcher: main= is on -- MiSTer_hybrid starts the game"
		exit 0
	fi
	waited=0
	while [ "$(cat /tmp/CORENAME 2>/dev/null)" != "$CORENAME" ]; do
		sleep 1
		waited=$((waited + 1))
		[ "$waited" -ge "$CORE_WAIT_S" ] && die "core did not come up within ${CORE_WAIT_S}s (CORENAME='$(cat /tmp/CORENAME 2>/dev/null)')"
	done
	echo "launcher: core up after ${waited}s"
fi

# Core already up: start the game unless it is running.
launcher_running && { echo "launcher: launch.sh already running"; exit 0; }
# Detach: the Scripts console returns to the menu while the game runs.
setsid "$HANDLER" < /dev/null >> "$LOGDIR/launch.log" 2>&1 &
echo "launcher: handler started (pid $!)"
exit 0
