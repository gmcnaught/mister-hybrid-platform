#!/bin/sh
#
# @TITLE@ -- stand-in for a pre-platform main= wrapper. GENERATED by
# mister-platform render from mister-port.toml [scripts] legacy_main.
#
# A MiSTer.ini written for an older release still says
#
#   [@CORENAME@]
#   main=@SELF@
#
# and an update replaced the wrapper binary that path used to hold with this
# script. MiSTer runs main= in place of itself (execl(main, main, rbf, xml)),
# so this script repoints that line at @HOOK@
# (backing MiSTer.ini up first) and then becomes it with the same arguments:
# the core loads, the game starts, and every later load skips this file.
#
# It must always end in exec: MiSTer is not respawned, so exiting here would
# leave the device with no menu and no OSD. When the hook or its registry entry
# is missing it runs the stock /media/fat/MiSTer instead (core only, no game).

# The MH_* overrides let a host test run this; MiSTer never sets them.
HOOK="${MH_HOOK:-@HOOK@}"
REGISTRY="${MH_REGISTRY:-@REGISTRY_DIR@}/@CORENAME@.conf"
PLATFORM="${MH_PLATFORM_DIR:-@GAMEDIR@/platform}"
STOCK="${MH_STOCK:-/media/fat/MiSTer}"
LOG="${MH_LOGDIR:-@LOGDIR@}/launch.log"
# shellcheck disable=SC2034  # read by platform/ini_main.sh
MH_INI_FILE="${MH_INI:-/media/fat/MiSTer.ini}"
# shellcheck disable=SC2034  # read by platform/ini_main.sh
MH_INI_SECTION="@CORENAME@"
SELF="@SELF@"

log() {
	mkdir -p "${LOG%/*}" 2>/dev/null
	echo "=== $(date) legacy main=$SELF: $*" >> "$LOG" 2>/dev/null
}

# update_all and zip extraction don't preserve the execute bit.
chmod +x "$HOOK" 2>/dev/null
if [ ! -x "$HOOK" ] || [ ! -f "$REGISTRY" ]; then
	log "$HOOK or $REGISTRY missing -- running $STOCK (core only)"
	exec "$STOCK" "$@"
fi

if [ -r "$PLATFORM/ini_main.sh" ]; then
	# shellcheck disable=SC1091
	. "$PLATFORM/ini_main.sh"
	# MiSTer resolves a relative main= against /media/fat, and older READMEs
	# gave the line in that form.
	case "$(mh_ini_main)" in
	"$SELF" | "${SELF#/media/fat/}")
		if mh_ini_set_main "$HOOK"; then
			log "MiSTer.ini [$MH_INI_SECTION] main= -> $HOOK"
		else
			log "could not rewrite MiSTer.ini; starting $HOOK anyway"
		fi
		;;
	esac
else
	log "missing $PLATFORM/ini_main.sh; MiSTer.ini left as is"
fi
exec "$HOOK" "$@"
