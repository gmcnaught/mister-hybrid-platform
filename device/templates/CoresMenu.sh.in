#!/bin/bash
#
# @TITLE@ -- Cores-menu toggle. GENERATED by mister-platform render (from
# maldita / cash.cow CoresMenu). Run once to make loading @CORENAME@ from the
# core list (_Other) start the game; run again to undo.
#
# It adds this to /media/fat/MiSTer.ini (backed up first):
#
#   [@CORENAME@]
#   main=@HOOK@
#
# main= is MiSTer's per-core "run this Main binary instead of /media/fat/MiSTer
# while this core is loaded". MiSTer_hybrid is upstream Main_MiSTer plus one call
# that looks the core up in @REGISTRY_DIR@/ and starts its launcher.
# An older main=@LEGACY_HOOK@ (platform v0.3.x) is replaced.
# Loading any other core switches back to the normal /media/fat/MiSTer. If
# MiSTer_hybrid is missing, MiSTer ignores the line and just loads the core.
#
# Scripts -> @NAME@ starts the game with or without this.

CORENAME="@CORENAME@"
# The MH_* overrides let a host test the MiSTer.ini edit; MiSTer never sets them.
WRAPPER="${MH_HOOK:-@HOOK@}"
REGISTRY="${MH_REGISTRY:-@REGISTRY_DIR@}/$CORENAME.conf"
PLATFORM="${MH_PLATFORM_DIR:-@GAMEDIR@/platform}"
MH_INI_FILE="${MH_INI:-/media/fat/MiSTer.ini}"
# shellcheck disable=SC2034  # read by platform/ini_main.sh
MH_INI_SECTION="$CORENAME"
# Only the hooked build contains this string (hybrid_registry.h); a stock
# Main_MiSTer renamed to MiSTer_hybrid would load the core and never start the game.
WRAPPER_MARK="MiSTer_hybrid registry: <binary dir>/hybrid.d"

die() { echo "$*" >&2; exit 1; }
[ -r "$PLATFORM/ini_main.sh" ] || die "not found: $PLATFORM/ini_main.sh -- extract the release zip over /media/fat again."
# shellcheck disable=SC1091
. "$PLATFORM/ini_main.sh"

# Only this core's section counts.
if [ "$(mh_ini_main)" = "$WRAPPER" ]; then
    echo "Cores-menu start is currently ON. Turning it off."
    mh_ini_disable_main "$WRAPPER" "@NAME@_CoresMenu" || die "edit failed -- $MH_INI_FILE is unchanged except for the backup"
    echo "Done. Loading the core no longer starts the game; use Scripts -> @NAME@."
    exit 0
fi

[ -f "$WRAPPER" ] || die "not found: $WRAPPER -- extract the release zip over /media/fat again."
[ -f "$REGISTRY" ] || die "not found: $REGISTRY -- extract the release zip over /media/fat again."
grep -q "$WRAPPER_MARK" "$WRAPPER" || die "$WRAPPER is not the MiSTer_hybrid build of MiSTer -- not using it."
[ -x "$WRAPPER" ] || chmod +x "$WRAPPER" || die "could not make $WRAPPER executable"
[ -f "$MH_INI_FILE" ] || echo "note: $MH_INI_FILE did not exist -- creating it with just this section."

echo "Turning Cores-menu start on."
old=$(mh_ini_main)
# Re-enables a commented line or replaces an older main= (e.g. a pre-platform
# per-game wrapper) in [@CORENAME@]; never adds a second [@CORENAME@] header.
mh_ini_set_main "$WRAPPER" || die "edit failed -- check $MH_INI_FILE (backups: $MH_INI_FILE.bak.*)"
[ -n "$old" ] && echo "Replaced main=$old"
echo "Done. Loading @CORENAME@ from the core list (_Other) now starts the game."
echo "Run this entry again to undo. Backups: $MH_INI_FILE.bak.*"
